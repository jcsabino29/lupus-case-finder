# Copy to .env (git-ignored). Never commit real values.
# Only synthetic data is allowed; the worker refuses any other value.
LCF_DATA_SOURCE=synthea
LCF_BATCH_SIZE=500
# Connection for a LOGIN role that is a member of ingest_worker (stage 1).
# Local Supabase example shown; never put hosted credentials in this file.
INGEST_DATABASE_URL=
