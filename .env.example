# Copy to .env.local for Next.js and .env for the Prisma CLI. Both are git-ignored.
# Never commit real values. Production values live only in Vercel and GitHub encrypted settings.
#
# Local Supabase (from `supabase start`) is shown as the default. The app must
# connect as a least-privilege LOGIN role (stage 1), never as `postgres`.

# Pooled connection used by the app at runtime (Supabase pooler, transaction mode, port 6543 when hosted)
DATABASE_URL=
# Direct connection used by the Prisma CLI (introspection only; DDL lives in supabase/migrations)
DIRECT_URL=

# Supabase Auth (public values; safe for the browser by design)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Used only on de-identified text (stage 4).
OPENAI_API_KEY=
